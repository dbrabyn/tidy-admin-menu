#: includes/class-admin-settings.php:540
msgid "Reset to Default"
msgstr "Auf Standard zurücksetzen"

#: includes/class-admin-settings.php:542
msgid "Restore the original WordPress menu order and show all hidden items."
msgstr "Die ursprüngliche WordPress-Menüreihenfolge wiederherstellen und alle ausgeblendeten Einträge anzeigen."

