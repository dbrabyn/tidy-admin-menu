#. Plugin Name of the plugin
#: tidy-admin-menu.php
#: includes/class-admin-settings.php:40
#: includes/class-admin-settings.php:41
#: includes/class-admin-settings.php:258
msgid "Tidy Admin Menu"
msgstr "Tidy Admin Menu"

#. Plugin URI of the plugin
#: tidy-admin-menu.php
msgid "https://github.com/dbrabyn/tidy-admin-menu"
msgstr "https://github.com/dbrabyn/tidy-admin-menu"

#. Description of the plugin
#: tidy-admin-menu.php
msgid "Declutter your WordPress dashboard by sorting and hiding admin menu items with a simple Show All toggle."
msgstr "Simplifica tu escritorio de WordPress ordenando y ocultando elementos del menú de administración con un simple botón Mostrar todo."

#. Author of the plugin
#: tidy-admin-menu.php
msgid "David Brabyn"
msgstr "David Brabyn"

#. Author URI of the plugin
#: tidy-admin-menu.php
msgid "https://9wdigital.com"
msgstr "https://9wdigital.com"

#: includes/class-admin-settings.php:122
msgid "Unsaved changes"
msgstr "Cambios sin guardar"

#: includes/class-admin-settings.php:123
msgid "Saving..."
msgstr "Guardando..."

#: includes/class-admin-settings.php:124
msgid "Saved"
msgstr "Guardado"

#: includes/class-admin-settings.php:125
msgid "Error saving. Please try again."
msgstr "Error al guardar. Por favor, inténtalo de nuevo."

#: includes/class-admin-settings.php:126
#: includes/class-admin-settings.php:354
msgid "Separator"
msgstr "Separador"

#: includes/class-admin-settings.php:127
#: includes/class-admin-settings.php:503
msgid "No file chosen"
msgstr "Ningún archivo seleccionado"

#: includes/class-admin-settings.php:128
msgid "Are you sure you want to reset the menu to default? This will restore the original WordPress menu order and show all hidden items."
msgstr "¿Estás seguro de que quieres restablecer el menú a los valores predeterminados? Esto restaurará el orden original del menú de WordPress y mostrará todos los elementos ocultos."

#: includes/class-admin-settings.php:129
#: includes/class-ajax-handler.php:312
msgid "Menu reset to default."
msgstr "Menú restablecido a los valores predeterminados."

#: includes/class-admin-settings.php:130
msgid "Error resetting menu. Please try again."
msgstr "Error al restablecer el menú. Por favor, inténtalo de nuevo."

#: includes/class-admin-settings.php:131
msgid "You have unsaved changes. Are you sure you want to switch roles? Your changes will be lost."
msgstr "Tienes cambios sin guardar. ¿Estás seguro de que quieres cambiar de rol? Tus cambios se perderán."

#: includes/class-admin-settings.php:132
msgid "Please select a file to import."
msgstr "Por favor, selecciona un archivo para importar."

#: includes/class-admin-settings.php:133
#: includes/class-admin-settings.php:357
msgid "Remove separator"
msgstr "Eliminar separador"

#. translators: %d: number of hidden submenu items
#: includes/class-admin-settings.php:134
#: includes/class-admin-settings.php:387
#, php-format
msgid "%d hidden"
msgstr "%d oculto(s)"

#: includes/class-admin-settings.php:135
#: includes/class-admin-settings.php:406
msgid "Hide all"
msgstr "Ocultar todo"

#: includes/class-admin-settings.php:136
#: includes/class-admin-settings.php:406
msgid "Show all"
msgstr "Mostrar todo"

#: includes/class-admin-settings.php:192
msgid "You do not have permission to access this page."
msgstr "No tienes permiso para acceder a esta página."

#: includes/class-admin-settings.php:259
msgid "Drag and drop menu items to reorder. Uncheck items to hide them from the admin menu."
msgstr "Arrastra y suelta los elementos del menú para reordenarlos. Desmarca los elementos para ocultarlos del menú de administración."

#. translators: %s: comma-separated list of menu item names
#: includes/class-admin-settings.php:267
#, php-format
msgid "The following menu items cannot be reordered because they are missing a menu slug: %s. The plugin or theme registering these items should specify a menu_slug parameter."
msgstr "Los siguientes elementos del menú no se pueden reordenar porque les falta un slug de menú: %s. El plugin o tema que registra estos elementos debería especificar un parámetro menu_slug."

#: includes/class-admin-settings.php:278
msgid "Role configuration tabs"
msgstr "Pestañas de configuración por rol"

#: includes/class-admin-settings.php:294
msgid "No users with this role"
msgstr "No hay usuarios con este rol"

#: includes/class-admin-settings.php:311
msgid "Show All Menu Items"
msgstr "Mostrar todos los elementos del menú"

#: includes/class-admin-settings.php:315
msgid "Show Submenu Items"
msgstr "Mostrar elementos del submenú"

#: includes/class-admin-settings.php:319
msgid "Add Separator"
msgstr "Añadir separador"

#: includes/class-admin-settings.php:323
msgid "Admin menu items"
msgstr "Elementos del menú de administración"

#. translators: %s: Menu item title
#: includes/class-admin-settings.php:367
#, php-format
msgid "Show %s in menu"
msgstr "Mostrar %s en el menú"

#. translators: %s: Menu item title
#: includes/class-admin-settings.php:395
#, php-format
msgid "Toggle submenus for %s"
msgstr "Mostrar/ocultar submenús de %s"

#. translators: %s: Submenu item title
#: includes/class-admin-settings.php:421
#, php-format
msgid "Show %s in submenu"
msgstr "Mostrar %s en el submenú"

#: includes/class-admin-settings.php:436
msgid "Tip: Use keyboard arrows with Alt key to reorder items."
msgstr "Consejo: usa las flechas del teclado con la tecla Alt para reordenar elementos."

#: includes/class-admin-settings.php:442
msgid "Hide \"Collapse menu\" toggle"
msgstr "Ocultar el botón «Contraer menú»"

#: includes/class-admin-settings.php:445
msgid "Hide submenu items"
msgstr "Ocultar elementos del submenú"

#: includes/class-admin-settings.php:450
msgid "Appearance → Theme File Editor"
msgstr "Apariencia → Editor de archivos del tema"

#: includes/class-admin-settings.php:452
msgid "Hides direct theme code editing — a common security recommendation."
msgstr "Oculta la edición directa del código del tema — una recomendación de seguridad habitual."

#: includes/class-admin-settings.php:458
msgid "Plugins → Plugin File Editor"
msgstr "Plugins → Editor de archivos de plugins"

#: includes/class-admin-settings.php:460
msgid "Hides direct plugin code editing — a common security recommendation."
msgstr "Oculta la edición directa del código de plugins — una recomendación de seguridad habitual."

#: includes/class-admin-settings.php:466
msgid "Tools → Available Tools"
msgstr "Herramientas → Herramientas disponibles"

#: includes/class-admin-settings.php:468
msgid "Removes the mostly empty Available Tools page — rarely useful in modern WordPress."
msgstr "Elimina la página Herramientas disponibles, casi vacía — rara vez útil en WordPress moderno."

#: includes/class-admin-settings.php:474
msgid "Settings → Privacy"
msgstr "Ajustes → Privacidad"

#: includes/class-admin-settings.php:476
msgid "Hides the Privacy settings page — useful once your Privacy Policy page is already set."
msgstr "Oculta la página de ajustes de Privacidad — útil una vez que tu página de Política de privacidad ya está configurada."

#: includes/class-admin-settings.php:482
msgid "Appearance → Customize"
msgstr "Apariencia → Personalizar"

#: includes/class-admin-settings.php:484
msgid "Hides the Customizer — useful for block themes that don't use it."
msgstr "Oculta el Personalizador — útil para temas de bloques que no lo utilizan."

